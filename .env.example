# FinOps Agent Configuration Template

# Google Gemini API (Cloud Provider for Tier 2/3)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Tier Mapping — rolling "-latest" aliases (see docs/LEARN.md for why not
# dated snapshots like gemini-2.0-flash-lite)
MODEL_TIER_FRONTIER=gemini-flash-latest       # T3: complex reasoning & fraud memos
MODEL_TIER_MID=gemini-flash-lite-latest       # T2: routine agent tool-calling & triage
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5        # T1 triage classifier + policy RAG (fastembed, local)

# T1 (fast tier) is deliberately LLM-free: rules + a local sklearn classifier.
# Only T2/T3 call Gemini. No Ollama / local LLM server required.

# Database (MySQL 8 — create a database + user and point this at it)
DATABASE_URL=mysql+pymysql://finops_user:finops_password@localhost:3306/finops_db

# Security & App Config
ENV=development
LOG_LEVEL=INFO
PII_VAULT_AES_KEY=change_me_32_byte_key_for_prod!
APPROVAL_JWT_SECRET=change_me_jwt_secret_for_prod
AUDIT_SIGNING_SECRET=change_me_audit_signing_secret
POLICY_VERSION=2026.08.01
